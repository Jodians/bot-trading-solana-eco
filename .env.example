# ===== SOLANA SNIPER CONFIG =====
# Copy this file to ".env" and fill in real values.
# NEVER commit your real .env file.

# --- Helius RPC (https://helius.xyz) ---
# Used for on-chain reads (mint/freeze authority, balances).
HELIUS_API_KEY=your_helius_api_key_here
# Full RPC URL (includes key):
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=your_helius_api_key_here

# --- Wallet (base58 private key, the secret seed) ---
# Generate a NEW, dedicated wallet for this bot. Do NOT reuse a wallet holding
# real funds. If this leaks you lose everything in it.
WALLET_PRIVATE_KEY=your_base58_private_key_here

# --- Jupiter Ultra swap API (https://jup.ag) ---
JUPITER_ULTRA_URL=https://lite-api.jup.ag/ultra/v1
# Slippage tolerance in basis points (100 = 1%) for quotes AND live swaps.
# 1000 (10%) is a realistic floor for fresh pump.fun tokens; tighter values make
# live swaps fail outright. Paper mode quotes with the same tolerance.
SLIPPAGE_BPS=1000
# Dashboard bind address. Loopback by default: both the HTTP page and the
# WebSocket are UNAUTHENTICATED and the WS accepts pause/resume commands.
# Set 0.0.0.0 only on a network you trust (e.g. to view from your phone).
DASHBOARD_HOST=127.0.0.1

# --- Trading params ---
# LIVE_TRADING must be "false" (paper/dry-run) until YOU explicitly enable it.
LIVE_TRADING=false

# Amount of SOL per buy (as string, e.g. "0.1" SOL)
BUY_AMOUNT_SOL=0.1

# Take-profit / stop-loss as decimals: 2.0 = +100%, 0.5 = -50%
TAKE_PROFIT_MULTIPLE=2.0
STOP_LOSS_MULTIPLE=0.5

# Max tokens held at once
MAX_OPEN_POSITIONS=3

# Sell delay after buy (seconds) - gives price time to move
SELL_DELAY_SEC=30

# How often (seconds) to re-check price for open positions (TP/SL monitor)
PRICE_CHECK_SEC=10

# --- Listener mode ---
# Use Helius WebSocket (faster discovery) instead of polling pump.fun.
# Requires a valid HELIUS_API_KEY. Set true to enable.
USE_WEBSOCKET=false

# Uses Conduit (OpenAI-compatible chat/completions). Enable to gate buys on an
# LLM quality verdict. Disabled by default (pure on-chain filters only).
LLM_ANALYSIS_ENABLED=false
CONDUIT_API_KEY=sk-cdt-your_conduit_key_here
CONDUIT_BASE_URL=https://conduit.ozdoev.net/v1
LLM_MODEL=gpt-4o
LLM_MAX_TOKENS=400
# Minimum LLM score (0-100) required to allow a BUY.
LLM_MIN_SCORE=60

# --- Telegram notifications (OPTIONAL) ---
# Isi kalau mau dapat alert realtime (BUY / SELL / TP / SL) di HP via Telegram.
# Kosongkan -> notifier jadi no-op (bot tetap jalan normal).
# Dapat token: chat @BotFather -> /newbot. Dapat chat_id: forward pesan ke @raw_data_bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Advanced quality filters (momentum sniper) ---
MIN_LIQUIDITY_USD=0
MIN_TXNS_H1=2
MIN_PRICE_CHANGE_H1_PCT=0
MIN_PAIR_AGE_SEC=0

# --- Anti-rug gates ---
# Max % of the circulating float (bonding curve excluded) one wallet may hold.
# 60 is permissive-but-useful on fresh mints; 0 disables (saves 1 RPC/token).
MAX_TOP_HOLDER_PCT=60
# Min % of BUY_AMOUNT_SOL recoverable by selling straight back. Catches
# honeypots (no sell route) + unexitable liquidity. 0 disables (saves 2 quotes).
MIN_ROUND_TRIP_PCT=80

# --- Live-execution safety ---
# Hard cap on hold time (seconds). Without it TP/SL are the only exits, so a
# token that flatlines between them ties up a position slot forever.
# 0 disables - NOT recommended for live.
MAX_HOLD_SEC=900
# SOL kept back for signature fees, ATA rent and the eventual sell. A live buy
# is skipped when balance - BUY_AMOUNT_SOL would fall below this.
MIN_SOL_RESERVE=0.02
# Extra priority fee (lamports) for live swaps. 0 = let Jupiter price it.
# An unprioritised tx often fails to land during a launch burst.
PRIORITY_FEE_LAMPORTS=0
# Seconds to wait for a live swap signature to confirm on-chain. An unconfirmed
# buy opens no position; an unconfirmed sell keeps the position open to retry.
CONFIRM_TIMEOUT_SEC=45
